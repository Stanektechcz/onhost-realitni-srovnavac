APP_NAME="ONhost Reality"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_FAKER_LOCALE=cs_CZ

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Produkce (aaPanel) – MariaDB:
# DB_CONNECTION=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=reality
# DB_USERNAME=reality
# DB_PASSWORD=

# Feature přepínače (výchozí vypnuto)
REALITY_FEATURE_MEMBERSHIPS=false
REALITY_FEATURE_PAYMENTS=false
REALITY_FEATURE_COMMISSIONS=false
REALITY_PAYMENT_PROVIDER=stub
REALITY_LISTING_LIFETIME_DAYS=60

# ONhost ID (OIDC, id.onhost.cz) – vypnuto, údaje klienta dodá vlastník
ONHOST_OIDC_ENABLED=false
ONHOST_OIDC_ISSUER=https://id.onhost.cz
ONHOST_OIDC_CLIENT_ID=
ONHOST_OIDC_CLIENT_SECRET=
ONHOST_OIDC_REDIRECT_URI=
ONHOST_OIDC_BACKCHANNEL=false
# ONhost ID + platba kreditem ONhost (výchozí vypnuto; viz README „Kredit ONhost“)
ONHOST_CREDIT_ENABLED=false
ONHOST_CREDIT_FAMILY=listing
ONHOST_CREDIT_ALLOW_BONUS=true
ONHOST_CREDIT_TIMEOUT=10
ONHOST_CREDIT_CONNECT_TIMEOUT=3
# prázdné ONHOST_ID_* = použije se klient ONHOST_OIDC_* výše
ONHOST_ID_ISSUER=
ONHOST_ID_CLIENT_ID=
ONHOST_ID_CLIENT_SECRET=
ONHOST_ID_REDIRECT_URI=
ONHOST_API_URL=
